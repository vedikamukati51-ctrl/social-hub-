# Dependencies (Never push node_modules to GitHub)
node_modules/

# Environment variables & secrets (CRUCIAL: Keeps your database credentials & JWT keys safe)
.env

# Uploaded user images (keep folder structure via .gitkeep)
public/images/uploads/*
!public/images/uploads/.gitkeep

# Logs & temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
