<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Edit Post | SocialHub</title>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen">

    <%- include('partials/nav') %>

    <main class="max-w-xl mx-auto py-10 px-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl">
            <h2 class="text-xl font-bold text-white mb-1">Edit your post</h2>
            <p class="text-xs text-zinc-400 mb-5">Update your message below and click save.</p>

            <form action="/update/<%= post._id %>" method="post" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Post Content</label>
                    <textarea name="content" rows="5" required
                        class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-xl p-3.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500 resize-none transition"><%= post.content %></textarea>
                </div>

                <% if (post.image) { %>
                    <div class="rounded-xl overflow-hidden border border-zinc-800 max-h-60 bg-zinc-950">
                        <img src="/images/uploads/<%= post.image %>" class="w-full h-full object-cover" alt="Post attachment">
                    </div>
                <% } %>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <a href="/profile" class="text-xs font-medium text-zinc-400 hover:text-white px-4 py-2 rounded-lg transition">
                        Cancel
                    </a>
                    <button type="submit"
                        class="bg-yellow-500 hover:bg-yellow-400 text-zinc-950 font-semibold text-xs px-5 py-2.5 rounded-lg transition shadow-md shadow-yellow-500/20">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </main>

</body>
</html>
