<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Feed | SocialHub</title>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen">

    <%- include('partials/nav') %>

    <main class="max-w-2xl mx-auto py-8 px-4 space-y-6">

        <!-- Create Post Card -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-start gap-3">
                <% if (user.profilePic && user.profilePic !== 'default-avatar.svg') { %>
                    <img src="/images/uploads/<%= user.profilePic %>" class="w-10 h-10 rounded-full object-cover border border-zinc-700" alt="avatar">
                <% } else { %>
                    <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm uppercase">
                        <%= user.name[0] %>
                    </div>
                <% } %>

                <form action="/post" method="post" enctype="multipart/form-data" class="flex-1 space-y-3">
                    <textarea name="content" rows="3" placeholder="What's happening, <%= user.name %>?"
                        class="w-full bg-zinc-800/60 border border-zinc-700/60 rounded-xl p-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none transition"></textarea>

                    <div class="flex items-center justify-between pt-1">
                        <!-- File Upload with Multer -->
                        <label class="flex items-center gap-2 text-xs text-zinc-400 hover:text-blue-400 cursor-pointer bg-zinc-800/80 hover:bg-zinc-800 border border-zinc-700/60 px-3 py-1.5 rounded-lg transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span id="file-label">Add Photo</span>
                            <input type="file" name="image" accept="image/*" class="hidden" onchange="document.getElementById('file-label').innerText = this.files[0] ? this.files[0].name.slice(0, 15) + '...' : 'Add Photo'">
                        </label>

                        <button type="submit"
                            class="bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs sm:text-sm px-5 py-2 rounded-lg transition shadow-md shadow-blue-600/20">
                            Post
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Feed Stream -->
        <div class="space-y-4">
            <% if (posts.length === 0) { %>
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-12 text-center text-zinc-500">
                    <p class="text-base font-medium">No posts in the feed yet.</p>
                    <p class="text-xs mt-1">Be the first to share something above!</p>
                </div>
            <% } %>

            <% posts.forEach(function(post) { %>
                <% const postAuthor = post.user || {}; %>
                <article class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-sm hover:border-zinc-700/80 transition">
                    <!-- Post Header -->
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <% if (postAuthor.profilePic && postAuthor.profilePic !== 'default-avatar.svg') { %>
                                <img src="/images/uploads/<%= postAuthor.profilePic %>" class="w-9 h-9 rounded-full object-cover border border-zinc-700" alt="avatar">
                            <% } else { %>
                                <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs uppercase">
                                    <%= postAuthor.name ? postAuthor.name[0] : 'U' %>
                                </div>
                            <% } %>
                            <div>
                                <h4 class="text-sm font-semibold text-white leading-tight">
                                    <%= postAuthor.name || 'Anonymous' %>
                                </h4>
                                <span class="text-xs text-zinc-500">
                                    @<%= postAuthor.username || 'user' %> • <%= new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                </span>
                            </div>
                        </div>

                        <% if (postAuthor._id && postAuthor._id.toString() === user._id.toString()) { %>
                            <div class="flex items-center gap-2 text-xs">
                                <a href="/edit/<%= post._id %>" class="text-zinc-400 hover:text-yellow-400 transition">Edit</a>
                                <span class="text-zinc-700">•</span>
                                <a href="/delete/<%= post._id %>" onclick="return confirm('Are you sure you want to delete this post?')" class="text-zinc-400 hover:text-red-400 transition">Delete</a>
                            </div>
                        <% } %>
                    </div>

                    <!-- Post Body -->
                    <% if (post.content) { %>
                        <p class="text-sm text-zinc-200 leading-relaxed whitespace-pre-wrap"><%= post.content %></p>
                    <% } %>

                    <!-- Post Image (Multer) -->
                    <% if (post.image) { %>
                        <div class="mt-3 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950">
                            <img src="/images/uploads/<%= post.image %>" alt="Post attachment" class="w-full max-h-96 object-cover hover:scale-[1.01] transition duration-300">
                        </div>
                    <% } %>

                    <!-- Post Actions -->
                    <div class="flex items-center gap-4 mt-4 pt-3 border-t border-zinc-800/80">
                        <% const isLiked = post.likes && post.likes.some(id => id.toString() === user._id.toString()); %>
                        <a href="/like/<%= post._id %>" class="flex items-center gap-1.5 text-xs font-medium transition <%= isLiked ? 'text-red-500' : 'text-zinc-400 hover:text-red-400' %>">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 <%= isLiked ? 'fill-current' : '' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                            </svg>
                            <span><%= post.likes ? post.likes.length : 0 %> <%= post.likes && post.likes.length === 1 ? 'Like' : 'Likes' %></span>
                        </a>
                    </div>
                </article>
            <% }) %>
        </div>
    </main>

</body>
</html>
