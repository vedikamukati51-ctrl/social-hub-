<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Register | SocialHub</title>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-xl">
        <div class="text-center mb-6">
            <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center text-white text-xl font-bold mx-auto mb-3 shadow-lg shadow-blue-500/20">
                S
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-white">Create an account</h2>
            <p class="text-sm text-zinc-400 mt-1">Join SocialHub and connect with others</p>
        </div>

        <% if (error) { %>
            <div class="mb-5 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-lg">
                <%= error %>
            </div>
        <% } %>

        <form action="/register" method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Full Name</label>
                <input type="text" name="name" required placeholder="John Doe"
                    class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
            </div>

            <div>
                <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Username</label>
                <input type="text" name="username" required placeholder="johndoe"
                    class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
            </div>

            <div>
                <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Email Address</label>
                <input type="email" name="email" required placeholder="john@example.com"
                    class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Age</label>
                    <input type="number" name="age" placeholder="21"
                        class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 uppercase mb-1.5">Password</label>
                    <input type="password" name="password" required placeholder="••••••••"
                        class="w-full bg-zinc-800/80 border border-zinc-700/80 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
                </div>
            </div>

            <button type="submit"
                class="w-full mt-2 bg-blue-600 hover:bg-blue-500 text-white font-medium py-2.5 rounded-lg text-sm transition duration-200 shadow-md shadow-blue-600/20">
                Create Account
            </button>
        </form>

        <p class="text-center text-sm text-zinc-400 mt-6">
            Already have an account? 
            <a href="/login" class="text-blue-400 hover:text-blue-300 font-medium">Log in</a>
        </p>
    </div>
</body>
</html>
