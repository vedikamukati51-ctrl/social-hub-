                <img src="/images/uploads/<%= user.profilePic %>" class="w-7 h-7 rounded-full object-cover border border-zinc-700" alt="avatar">
            <% } else { %>
                <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-semibold uppercase">
                    <%= (user && user.name) ? user.name[0] : 'U' %>
                </div>
            <% } %>
            <span class="hidden sm:inline text-zinc-200"><%= (user && user.name) ? user.name : 'Profile' %></span>
        </a>
        <a href="/logout" class="bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition">
