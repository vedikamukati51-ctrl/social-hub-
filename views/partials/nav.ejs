<nav class="sticky top-0 z-50 bg-zinc-900/95 backdrop-blur border-b border-zinc-800 px-4 sm:px-8 py-3.5 flex items-center justify-between">
    <a href="/feed" class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
        <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white text-sm font-black shadow-md shadow-blue-500/20">S</span>
        <span>Social<span class="text-blue-500">Hub</span></span>
    </a>
    <div class="flex items-center gap-3 sm:gap-5 text-sm font-medium">
